    <!--        Calender function for auto hide-->
    <script>
        const calendarEvents = document.querySelectorAll('.calEvents');
        calendarEvents.forEach(event => {
            const eventDate = new Date(event.getAttribute('datetime'));
            (new Date() > eventDate) ? event.style.display = 'none': '';
        })
    </script>

